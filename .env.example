# Copy to .env and obtain values from the maintainer. Never commit real secrets.
# Names must match src/mkts_backend/config/settings.toml.

# Existing market databases: needed to download their data.
# See docs/setup.md for details 

# primary market
TURSO_WCMKTNEWKEEP_URL=
TURSO_WCMKTNEWKEEP_TOKEN=

# development
TURSO_WCMKTNORTH_URL=
TURSO_WCMKTNORTH_TOKEN=

# market3
TURSO_WCMKTBKG_URL=
TURSO_WCMKTBKG_TOKEN=

# Shared item reference and fittings databases.
TURSO_SDE2_URL=
TURSO_SDE2_TOKEN=
TURSO_FITTING_URL=
TURSO_FITTING_TOKEN=

# EVE API credentials: run `uv run mkts-backend esi-auth` to populate these.
CLIENT_ID=
SECRET_KEY=
REFRESH_TOKEN=

# Optional for market collection; required when using builder-cost commands.
TURSO_BUILDCOST_URL=
TURSO_BUILDCOST_TOKEN=

# Optional development database.
TURSO_WCMKTTEST_URL=
TURSO_WCMKTTEST_TOKEN=

# Optional Jita fallback and Google Sheets service-account JSON file.
JANICE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
